# .editorconfig
# ‾‾‾‾‾‾‾‾‾‾‾‾‾
root = true

[*]
    charset              = utf-8
    end_of_line          = lf
    insert_final_newline = true
    spelling_language    = en-GB

[*.{[ch],json{c,}}]
    indent_style = tab
    indent_size  = 4

[*.zsh]
    indent_style = space
    indent_size  = 2

[.{editorconfig,gitignore}]
    indent_style = space
    indent_size  = 4
